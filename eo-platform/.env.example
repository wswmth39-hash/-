# Copy to .env and adjust. Never commit .env (it is git-ignored).
EO_HOST=127.0.0.1
EO_PORT=8000
# EO_HOME=/var/lib/eoplatform          # data dir (DB, models, logs). Default: ./var
# EO_SESSION_SECRET=                   # optional; auto-generated into $EO_HOME/.session_secret (0600)
EO_COOKIE_SECURE=false                 # set true when served over HTTPS

# Data
EO_ENABLE_BINANCE=true                 # reference feed for REGULAR crypto markets only (never OTC)
EO_BRIDGE_ENABLED=true                 # ExpertOption browser bridge (the only ExpertOption/OTC source)
EO_RETENTION_DAYS=30
EO_LIVE_MAX_AGE=3
EO_DELAYED_MAX_AGE=10
EO_STALE_MAX_AGE=60

# Decision policy
EO_PAYOUT=0.80                         # your typical payout; break-even accuracy = 1/(1+payout)
EO_REQUIRE_VALIDATED_MODEL=true        # publish BUY/SELL only with validated out-of-sample evidence
EO_MIN_VALIDATION_SAMPLES=200

# Local LLM (no paid API). Ollama exposes an OpenAI-compatible API at /v1.
EO_LLM_ENABLED=true
EO_LLM_PROVIDER=ollama
EO_LLM_MODEL=qwen3.5:9b
EO_LLM_BASE_URL=http://127.0.0.1:11434/v1
EO_LLM_TIMEOUT=120
EO_LLM_DEBATE_ROUNDS=1
EO_LLM_RISK_ROUNDS=1

EO_MONITOR_INTERVAL=15
EO_RETRAIN_INTERVAL_MIN=360
