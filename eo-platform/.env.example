# Copy to .env and adjust. Never commit .env (it is git-ignored).
EO_HOST=127.0.0.1
EO_PORT=8000
# EO_HOME=/var/lib/eoplatform          # data dir (DB, models, logs). Default: ./var
# EO_SESSION_SECRET=                   # optional; auto-generated into $EO_HOME/.session_secret (0600)
EO_COOKIE_SECURE=false                 # set true when served over HTTPS

# Data
EO_ENABLE_BINANCE=true                 # reference feed for REGULAR crypto markets only (never OTC)
EO_BINANCE_BACKFILL_HOURS=24          # history fetched on start (only missing seconds)
# ExpertOption browser bridge (the only ExpertOption/OTC source). OFF by default:
# ExpertOption T&C §6.2 prohibits "implantations to the client-server relationship" and bots,
# with account blocking and fund seizure. Enable only after reading bridge/README.md.
EO_BRIDGE_ENABLED=false
EO_NEWS_ENABLED=true                   # free economic calendar (high-impact events → risk veto)
EO_NEWS_WINDOW_MIN=30
# EO_ALERT_WEBHOOK=https://ntfy.sh/your-private-topic   # optional push alerts on outages/halts
EO_RETENTION_DAYS=30
EO_LIVE_MAX_AGE=3
EO_DELAYED_MAX_AGE=10
EO_STALE_MAX_AGE=60

# Decision policy
EO_PAYOUT=0.80                         # your typical payout; break-even accuracy = 1/(1+payout)
# EO_PAYOUT_MAP=BTCUSD=0.82,ETHUSD=0.78 # optional per-market payouts YOU see on ExpertOption (never guessed)
EO_REQUIRE_VALIDATED_MODEL=true        # publish BUY/SELL only with validated out-of-sample evidence
EO_MIN_VALIDATION_SAMPLES=200        # independent (non-overlapping) out-of-sample trades
EO_EXEC_DELAY_S=1                      # entry 1 s after candle close in training labels
EO_COST_BUFFER=0.01                    # required accuracy = break-even + this
EO_LEDGER_DAYS=7                       # multiple-testing family spans every test in this window

# Local LLM (no paid API). Ollama exposes an OpenAI-compatible API at /v1.
EO_LLM_ENABLED=true
EO_LLM_PROVIDER=ollama
EO_LLM_MODEL=qwen3.5:9b
EO_LLM_BASE_URL=http://127.0.0.1:11434/v1
EO_LLM_TIMEOUT=120
EO_LLM_PROFILE=fast                    # fast: LLM only for debate/judgement/risk/final (~90-100 s); full: every node (~344 s)
EO_LLM_KEEP_ALIVE=60m                  # keep the model loaded (cold load measured 29.9 s)
EO_LLM_REASONING=none                  # Qwen 3.5 thinks by default: 264 s & empty answer vs 15 s with none (measured)
EO_LLM_DEBATE_ROUNDS=1
EO_LLM_RISK_ROUNDS=1

EO_MONITOR_INTERVAL=15
EO_RETRAIN_INTERVAL_MIN=360

# Telegram bot (optional) — see docs/TELEGRAM.md
# EO_TELEGRAM_TOKEN=123456789:ABC...            # from @BotFather; keep secret, never commit
#   (EO_TELEGRAM_BOT_TOKEN is accepted as an alias for EO_TELEGRAM_TOKEN)
# EO_TELEGRAM_ALLOWED_USERS=111111111,222222222 # numeric user IDs allowed to use the bot (empty = nobody)
# EO_TELEGRAM_ALERTS=true                      # push important alerts to the allowed users (max 20/hour)
# EO_SIGNAL_STYLE=image                       # "full" (honest WAIT bot) | "image" (owner design: always BUY/SELL on BTC/ETH/LTC/XRP)
# EO_TELEGRAM_ACCESS_CODE=                     # secret code users must enter before using the bot (stored hashed; owner can change it from the dashboard)
